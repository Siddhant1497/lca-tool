    "react-dom": "^18.3.1",
    "read-excel-file": "^9.3.14",
    "recharts": "^2.13.3",
    "uuid": "^10.0.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^2.1.9"
  }
