{
  "name": "lca-tool",
  "version": "1.0.0",
  "description": "SustainHub: GHG inventory, decarbonisation pathway, certification portfolio and building LCA (LEED, EN 15978, ISO 14044, BREEAM)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run build:viewer && vite build",
